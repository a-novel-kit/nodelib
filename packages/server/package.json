{
  "name": "@a-novel-kit/nodelib-server",
  "version": "2.4.0",
  "private": false,
  "description": "Framework-independent server runtime primitives for a-novel platform applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-novel-kit/nodelib.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
