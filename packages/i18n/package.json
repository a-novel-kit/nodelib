{
  "name": "@a-novel-kit/nodelib-i18n",
  "version": "1.6.3",
  "private": false,
  "description": "Scoped i18next runtime helpers for request-rendered applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-novel-kit/nodelib.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "svelte": "./dist/svelte/index.es.js",
      "import": "./dist/svelte/index.es.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "i18next": "^26.4.0",
    "svelte": "^5.57.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.9.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
