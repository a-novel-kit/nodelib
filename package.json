{
  "name": "nodelib-project",
  "version": "1.6.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-novel-kit/nodelib.git"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    ".",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm build:browser && pnpm build:config && pnpm build:i18n && pnpm build:server && pnpm build:node",
    "build:browser": "pnpm compile:browser && pnpm types:browser",
    "build:config": "pnpm compile:config && pnpm types:config",
    "build:i18n": "pnpm compile:i18n && pnpm types:i18n",
    "build:node": "pnpm compile:node && pnpm types:node",
    "build:server": "pnpm compile:server && pnpm types:server",
    "compile:browser": "rm -rf ./packages/browser/dist && vite build --outDir ./packages/browser/dist -c packages/browser/vite.config.ts",
    "compile:config": "rm -rf ./packages/configs/dist && vite build --outDir ./packages/configs/dist -c packages/configs/vite.config.ts",
    "compile:i18n": "rm -rf ./packages/i18n/dist && vite build --outDir ./packages/i18n/dist -c packages/i18n/vite.config.ts",
    "compile:node": "rm -rf ./packages/test/dist && vite build --outDir ./packages/test/dist -c packages/test/vite.config.ts",
    "compile:server": "rm -rf ./packages/server/dist && vite build --outDir ./packages/server/dist -c packages/server/vite.config.ts",
    "format": "prettier --write . --config prettier.config.ts",
    "i18n:check": "pnpm i18n:extract:check && pnpm i18n:types:check && pnpm i18n:status && pnpm i18n:unused",
    "i18n:extract": "i18next-cli extract --with-types",
    "i18n:extract:check": "i18next-cli extract --ci --quiet",
    "i18n:status": "i18next-cli status",
    "i18n:types": "i18next-cli types",
    "i18n:types:check": "i18next-cli types --ci --quiet",
    "i18n:unused": "i18next-cli status --unused",
    "preinstall": "npx only-allow pnpm",
    "lint": "pnpm lint:stylecheck && pnpm lint:typecheck && pnpm lint:eslint",
    "lint:ci": "pnpm build:config && pnpm build:browser && pnpm build:i18n && pnpm i18n:check && pnpm lint",
    "lint:eslint": "eslint .",
    "lint:stylecheck": "prettier --check . --config prettier.config.ts",
    "lint:typecheck": "pnpm lint:typecheck:browser && pnpm lint:typecheck:configs && pnpm lint:typecheck:i18n && pnpm lint:typecheck:server && pnpm lint:typecheck:test",
    "lint:typecheck:browser": "pnpm tsc --p ./packages/browser/tsconfig.json --noEmit",
    "lint:typecheck:configs": "pnpm tsc --p ./packages/configs/tsconfig.json --noEmit",
    "lint:typecheck:i18n": "pnpm tsc --p ./packages/i18n/tsconfig.json --noEmit",
    "lint:typecheck:server": "pnpm tsc --p ./packages/server/tsconfig.json --noEmit",
    "lint:typecheck:test": "pnpm tsc --p ./packages/test/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:ci": "pnpm build:config && pnpm build:browser && pnpm build:i18n && pnpm test",
    "types:browser": "tsc --project packages/browser/tsconfig.build.json",
    "types:config": "tsc --project packages/configs/tsconfig.build.json",
    "types:i18n": "tsc --project packages/i18n/tsconfig.build.json",
    "types:node": "tsc --project packages/test/tsconfig.build.json",
    "types:server": "tsc --project packages/server/tsconfig.build.json"
  },
  "devDependencies": {
    "@a-novel-kit/nodelib-config": "catalog:",
    "@eslint/config-helpers": "catalog:",
    "@eslint/js": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@sveltejs/adapter-node": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@trivago/prettier-plugin-sort-imports": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "estree-walker": "catalog:",
    "globals": "catalog:",
    "i18next": "catalog:",
    "i18next-cli": "catalog:",
    "i18next-cli-plugin-svelte": "catalog:",
    "jiti": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-css-order": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.9.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
