{
  "name": "nodelib-project",
  "version": "2.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-novel-kit/nodelib.git"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    ".",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm build:browser && pnpm build:config && pnpm build:i18n && pnpm build:server && pnpm build:test",
    "build:browser": "vite build -c packages/browser/vite.config.ts && tsc -p packages/browser/tsconfig.build.json",
    "build:config": "vite build -c packages/configs/vite.config.ts && tsc -p packages/configs/tsconfig.build.json",
    "build:i18n": "vite build -c packages/i18n/vite.config.ts && tsc -p packages/i18n/tsconfig.build.json",
    "build:server": "vite build -c packages/server/vite.config.ts && tsc -p packages/server/tsconfig.build.json",
    "build:test": "vite build -c packages/test/vite.config.ts && tsc -p packages/test/tsconfig.build.json",
    "format": "prettier --write . --config prettier.config.ts",
    "i18n:check": "pnpm i18n:extract:check && pnpm i18n:types:check && pnpm i18n:status && pnpm i18n:unused",
    "i18n:extract": "i18next-cli extract --with-types",
    "i18n:extract:check": "i18next-cli extract --ci --quiet",
    "i18n:status": "i18next-cli status",
    "i18n:types": "i18next-cli types",
    "i18n:types:check": "i18next-cli types --ci --quiet",
    "i18n:unused": "i18next-cli status --unused",
    "preinstall": "npx only-allow pnpm",
    "lint": "pnpm lint:stylecheck && pnpm lint:typecheck && pnpm lint:eslint",
    "lint:ci": "pnpm build:config && pnpm build:browser && pnpm i18n:check && pnpm lint",
    "lint:eslint": "eslint .",
    "lint:stylecheck": "prettier --check . --config prettier.config.ts",
    "lint:typecheck": "pnpm lint:typecheck:browser && pnpm lint:typecheck:config && pnpm lint:typecheck:i18n && pnpm lint:typecheck:server && pnpm lint:typecheck:test",
    "lint:typecheck:browser": "tsc -p packages/browser/tsconfig.json --noEmit",
    "lint:typecheck:config": "tsc -p packages/configs/tsconfig.json --noEmit",
    "lint:typecheck:i18n": "tsc -p packages/i18n/tsconfig.json --noEmit",
    "lint:typecheck:server": "tsc -p packages/server/tsconfig.json --noEmit",
    "lint:typecheck:test": "tsc -p packages/test/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:ci": "pnpm build:browser && pnpm test"
  },
  "devDependencies": {
    "@a-novel-kit/nodelib-config": "catalog:",
    "@eslint/config-helpers": "catalog:",
    "@eslint/js": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@sveltejs/adapter-node": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@trivago/prettier-plugin-sort-imports": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "estree-walker": "catalog:",
    "globals": "catalog:",
    "i18next": "catalog:",
    "i18next-cli": "catalog:",
    "i18next-cli-plugin-svelte": "catalog:",
    "jiti": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-css-order": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.9.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
